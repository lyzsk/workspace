# 【开发】子应用本地独立运行配置

# 开发服务端口。必须与主应用登记的子应用地址一致，否则主应用加载不到
VITE_PORT = 3010

# 开发环境部署基础路径保持根路径，生产环境才切到子路径
VITE_BASE_URL = /

# 接口基础路径。开发环境走 Vite 代理，保持相对路径
VITE_API_BASE_URL = /api

# 接口代理目标，指向本子应用自己的后端服务
VITE_API_PROXY = http://127.0.0.1:8082

# 是否使用本地模拟数据。后端未就绪时置 true，页面仍有数据可看
VITE_USE_MOCK = true

# 应用编码。必须与主应用 sys_app 表中的 code 一致，用于事件过滤与埋点
VITE_APP_CODE = ies

# 应用路由前缀。必须与主应用 sys_app 表中的 base_path 一致
VITE_APP_BASE_PATH = /apps/ies
