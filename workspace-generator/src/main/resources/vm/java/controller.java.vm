    @PutMapping("/{id}")
    @PreAuthorize("@ss.hasPerm('${permissionPrefix}:update')")
    @Log(module = "${functionName}", operation = "修改")
    public Result<Void> update(@PathVariable Long id, @RequestBody @Valid ${ClassName}Form form) {
        service.update(id, form);
        return Result.success();
    }

    @DeleteMapping("/{id}")
    @PreAuthorize("@ss.hasPerm('${permissionPrefix}:delete')")
