 * @since ${now}
 */
@RestController
@RequestMapping("/api/${moduleName}/${businessName}")
@RequiredArgsConstructor
public class ${ClassName}Controller {

    private final I${ClassName}Service service;

    @GetMapping
    @PreAuthorize("@ss.hasPerm('${permissionPrefix}:list')")
    public Result<PageResult<${ClassName}VO>> page(@Valid ${ClassName}Query query) {
        return Result.success(service.page(query));
    }

    @GetMapping("/{id}")
    @PreAuthorize("@ss.hasPerm('${permissionPrefix}:list')")
    public Result<${ClassName}VO> get(@PathVariable Long id) {
        return Result.success(service.get(id));
    }

