spring:
  cloud:
    gateway:
      default-filters:
        - name: RequestRateLimiter
          args:
            key-resolver: "#{@userOrIpKeyResolver}"
            redis-rate-limiter.replenishRate: ${GATEWAY_USER_RATE:100}
            redis-rate-limiter.burstCapacity: ${GATEWAY_USER_BURST:200}
            redis-rate-limiter.requestedTokens: 1
      routes:
        - id: business-app-example-api
          uri: lb://example-service
          order: 0
          predicates:
            - Path=/api/example-app/**
        - id: workspace-service-login
          uri: lb://workspace-service
          order: 0
          predicates:
            - Path=/api/auth/login
          filters:
            - name: RequestRateLimiter
              args:
                key-resolver: "#{@clientIpKeyResolver}"
                redis-rate-limiter.replenishRate: ${GATEWAY_LOGIN_RATE:5}
                redis-rate-limiter.burstCapacity: ${GATEWAY_LOGIN_BURST:10}
                redis-rate-limiter.requestedTokens: 1
        - id: workspace-service-api
          uri: lb://workspace-service
          order: 100
          predicates:
            - Path=/api/**
        - id: workspace-service-websocket
          uri: lb:ws://workspace-service
          order: 100
          predicates:
            - Path=/ws/**
